{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "plugins": ["@stryker-mutator/vitest-runner", "@stryker-mutator/typescript-checker"],
  "testRunner": "vitest",
  "vitest": { "configFile": "vitest.num.config.ts" },
  "checkers": ["typescript"],
  "tsconfigFile": "packages/num/tsconfig.json",
  "mutate": ["packages/num/src/**/*.ts", "!packages/num/src/index.ts"],
  "coverageAnalysis": "perTest",
  "incremental": true,
  "incrementalFile": "reports/mutation/num/stryker-incremental.json",
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": { "fileName": "reports/mutation/num/index.html" },
  "jsonReporter": { "fileName": "reports/mutation/num/mutation.json" },
  "thresholds": { "high": 90, "low": 80, "break": null },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": "always"
}
