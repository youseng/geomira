{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "plugins": ["@stryker-mutator/vitest-runner", "@stryker-mutator/typescript-checker"],
  "testRunner": "vitest",
  "vitest": { "configFile": "vitest.kernel.config.ts" },
  "checkers": ["typescript"],
  "tsconfigFile": "packages/kernel/tsconfig.json",
  "mutate": [
    "packages/kernel/src/geom.ts",
    "packages/kernel/src/similarity.ts",
    "packages/kernel/src/conic.ts",
    "packages/kernel/src/conic-glider.ts",
    "packages/kernel/src/conic-pencil.ts",
    "packages/kernel/src/conic-around.ts",
    "packages/kernel/src/conic-type.ts",
    "packages/kernel/src/tools/**/*.ts",
    "packages/kernel/src/transform/**/*.ts"
  ],
  "coverageAnalysis": "perTest",
  "incremental": true,
  "incrementalFile": "reports/mutation/kernel/stryker-incremental.json",
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": { "fileName": "reports/mutation/kernel/index.html" },
  "jsonReporter": { "fileName": "reports/mutation/kernel/mutation.json" },
  "thresholds": { "high": 90, "low": 75, "break": null },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": "always"
}
