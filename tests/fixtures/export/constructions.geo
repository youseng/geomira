# Every constructive mapping of the Asymptote export (ADR-0014), each object defined, so the
# coordinate check of tex.yml compares every helper with the kernel.
@version 1
@title "Export: constructions"
A = (0, 0)
B = (6, 0)
C = (1, 5)
P = (3, -2)
M = midpoint(A, B)
l = line(A, B)
s1 = segment(B, C)
r1 = ray(C, A)
F1 = foot(C, l)
F2 = foot(P, B, C)
O = circumcenter(A, B, C)
G = centroid(A, B, C)
H = orthocenter(A, B, C)
I = incenter(A, B, C)
w = circumcircle(A, B, C)
i = incircle(A, B, C)
c1 = circle(O, A)
c2 = circle(P, 3)
c3 = circle(A, B, C)
t = polygon(A, B, C)
X1 = intersect(l, line(C, P))
X2 = intersect(line(C, H), w, other(C))
X3 = intersect(line(P, I), w, along(+))
X4 = intersect(line(P, I), w, near(P))
X5 = intersect(line(P, I), w, far_from(P))
X6 = intersect(line(P, I), w, same_side(P, l))
X7 = intersect(line(P, I), w, opposite_side(P, l))
X8 = intersect(w, line(C, H), other(C))
X9 = intersect(l, i, along(+))
Y1 = intersect(w, c2, orient(+))
Y2 = intersect(w, circle(B, A), other(A))
Y3 = intersect(w, c2, near(B))
Y4 = intersect(w, c2, far_from(B))
Y5 = intersect(w, c2, same_side(B, line(O, P)))
Y6 = intersect(w, c2, opposite_side(B, line(O, P)))
k1 = circle(A, 6)
k2 = circle(M, 3)
Z = intersect(k1, k2, orient(+))
N1 = intersect(segment(C, P), w, near(P))
T1 = reflect(l)
T2 = reflect(P)
T3 = rotate(O, 60)
T4 = homothety(G, -1/2)
T5 = translate(A, P)
T6 = spiral(A, B, A, C)
T7 = compose(T1, T3)
T8 = inverse(T6)
C1 = apply(T7, C)
C2 = apply(T2, C)
l1 = apply(T4, l)
w1 = apply(T5, w)
t1 = apply(T8, t)
R1 = reflect(C, l)
R2 = rotate(C, O, 90)
R3 = homothety(H, G, 2)
R4 = translate(C, A, B)
R5 = spiral(C, A, B, A, C)
s2 = reflect(s1, P)
w2 = rotate(w, A, 30)
t2 = reflect(t, l)
k = 2/3
n1 = k + 1/2
n2 = k - 1
n3 = k * 3
n4 = k / 4
n5 = -k
R6 = rotate(B, A, n3 * 45)
R7 = homothety(C, A, n1)
R8 = homothety(C, A, n2)
R9 = homothety(C, A, n4)
R10 = homothety(C, A, n5)
H_d = midpoint(C, H) [hidden]
D = midpoint(H_d, A)
