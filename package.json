{
  "name": "geomira",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "pnpm -r run typecheck && tsc -p tsconfig.tests.json",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "depcruise": "depcruise packages apps/web/src --config .dependency-cruiser.cjs",
    "rules": "tsx scripts/check-rules.ts",
    "docs:tools": "tsx scripts/gen-tool-docs.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "mutation:num": "stryker run stryker.num.json",
    "mutation:kernel": "stryker run stryker.kernel.json",
    "verify": "pnpm typecheck && pnpm lint && pnpm depcruise && pnpm rules && pnpm test:coverage",
    "build": "pnpm --filter @geomira/web build",
    "e2e": "pnpm --filter @geomira/web e2e"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/typescript-checker": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "4.1.12",
    "@vitest/eslint-plugin": "1.6.27",
    "dependency-cruiser": "17.4.3",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
